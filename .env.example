# RapidRescue Driver Mobile App Environment Configuration Template
# Copy this file to .env and configure local values as needed.
# NEVER commit .env or any secret keys to version control.

# Service Mode: 'true' to use mock services (standalone dev/testing), 'false' for live FastAPI backend API
EXPO_PUBLIC_USE_MOCK_SERVICES=false

# Backend API Configuration (FastAPI Core - Hosted)
# Default hosted server host: https://web-production-2c3bd.up.railway.app
EXPO_PUBLIC_API_BASE_URL=https://web-production-2c3bd.up.railway.app

# Real-time WebSocket Gateway
# Format: wss://web-production-2c3bd.up.railway.app/ws/driver
EXPO_PUBLIC_WS_URL=wss://web-production-2c3bd.up.railway.app

# API Request Timeout in Milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

