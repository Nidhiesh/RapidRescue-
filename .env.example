# RapidRescue Driver Mobile App Environment Configuration Template
# Copy this file to .env and configure local values as needed.
# NEVER commit .env or any secret keys to version control.

# Backend API Configuration (FastAPI)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Real-time WebSocket Gateway
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws/driver

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development
