# RapidRescue Patient Mobile App Environment Configuration
# Copy this file to .env and adjust variables as per your local network/FastAPI server setup

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# FastAPI Backend REST Base URL
# For Android Emulator: http://10.0.2.2:8000/api/v1
# For Physical Android Device on same Wi-Fi: http://<YOUR_COMPUTER_LOCAL_IP>:8000/api/v1 (e.g. http://192.168.1.15:8000/api/v1)
# For Production: https://api.rapidrescue.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# FastAPI WebSocket Real-time URL
# For Android Emulator: ws://10.0.2.2:8000/ws
# For Physical Android Device: ws://<YOUR_COMPUTER_LOCAL_IP>:8000/ws
# For Production: wss://api.rapidrescue.com/ws
EXPO_PUBLIC_WS_BASE_URL=ws://10.0.2.2:8000/ws

# Network request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Feature Flags
# When true, services can fall back to mock handlers when backend is unreachable during testing
EXPO_PUBLIC_ENABLE_MOCKS=false
